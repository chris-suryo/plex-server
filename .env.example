# Copy to .env and fill in:   cp .env.example .env
# scripts/bootstrap.sh does the copy for you and fills in PUID, PGID and TZ.
# .env holds secrets. It is git-ignored; never commit it.

# ------------------------------------------------------------------ basics
PUID=1000
PGID=1000
UMASK=002
TZ=Etc/UTC

# App settings and databases (keep these on the SSD)
CONFIG_ROOT=/docker/appdata
# Downloads + media library (the big HDD, mounted at /data)
DATA_ROOT=/data

# Optional app groups, comma-separated, e.g. COMPOSE_PROFILES=usenet,torrent
#   usenet  = SABnzbd (needs a Usenet provider + indexer)
#   torrent = qBittorrent behind a Gluetun VPN (needs a VPN with port forwarding)
#   public  = Cloudflare Tunnel so friends can reach Seerr (needs a domain on Cloudflare)
COMPOSE_PROFILES=

# -------------------------------------------------------------------- plex
# Get one from https://www.plex.tv/claim right before the FIRST start.
# It expires after 4 minutes and is not needed afterwards.
PLEX_CLAIM=

# ---------------------------------------------------------------- api keys
# Fill in after the first start. Sonarr/Radarr: Settings > General > API Key.
# Used by Recyclarr (quality profiles) and Unpackerr.
SONARR_API_KEY=
RADARR_API_KEY=

# ------------------------------------------------- vpn (torrent profile only)
# Defaults are for ProtonVPN (paid plan) over WireGuard with port forwarding.
# When generating the WireGuard config in your Proton account, enable
# "NAT-PMP (Port Forwarding)". Other providers: see docs/04-configure-apps.md.
# Quote values that contain spaces, e.g. VPN_SERVICE_PROVIDER="private internet access"
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PRESHARED_KEY=
WIREGUARD_ADDRESSES=
OPENVPN_USER=
OPENVPN_PASSWORD=
# Optional, e.g. SERVER_COUNTRIES=Netherlands,Switzerland
SERVER_COUNTRIES=
VPN_PORT_FORWARDING=on
PORT_FORWARD_ONLY=on
# Only for providers with a fixed forwarded port (e.g. AirVPN)
FIREWALL_VPN_INPUT_PORTS=

# ---------------------------------------- cloudflare tunnel (public profile)
CLOUDFLARE_TUNNEL_TOKEN=
